{
  "name": "eNewsletter Tracker + Open/Click Automator v2",
  "nodes": [
    {
      "id": "a1",
      "name": "Create Campaign Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Create Open/Click Campaign",
        "formDescription": "Plan daily opens and clicks for a newsletter test.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "platform",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "desktop"
                  },
                  {
                    "option": "mobile"
                  },
                  {
                    "option": "both"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "opens_planned",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "clicks_planned",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "article_urls",
              "fieldType": "textarea",
              "placeholder": "One article URL per line",
              "requiredField": true
            },
            {
              "fieldLabel": "active",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "true"
                  },
                  {
                    "option": "false"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "webhookId": "enews2-campaign-form"
    },
    {
      "id": "a2",
      "name": "Pick Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: {\n  name: j.name,\n  platform: j.platform,\n  opens_planned: Number(j.opens_planned),\n  clicks_planned: Number(j.clicks_planned),\n  article_urls: j.article_urls,\n  active: String(j.active)\n}}];"
      }
    },
    {
      "id": "a3",
      "name": "Save Campaign",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      }
    },
    {
      "id": "b1",
      "name": "Every Day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "b2",
      "name": "Get Campaigns",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "returnAll": true
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "b3",
      "name": "Build Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const BASE = 'https://YOUR-N8N-DOMAIN';   // public URL of your n8n\nconst CAP = 200;                          // safety cap per campaign per action\nconst jobs = [];\nfor (const c of $('Get Campaigns').all().map(i => i.json)) {\n  if (!c.name || String(c.active) !== 'true') continue;\n  const articles = String(c.article_urls || '').split('\\n').map(s => s.trim()).filter(Boolean);\n  const platforms = c.platform === 'both' ? ['desktop', 'mobile'] : [c.platform];\n  const pixel = `${BASE}/webhook/t/open?c=${encodeURIComponent(c.name)}&r=automator`;\n  for (const p of platforms) {\n    for (let i = 0; i < Math.min(Number(c.opens_planned), CAP); i++)\n      jobs.push({ json: { campaign: c.name, platform: p, action: 'open', url: pixel } });\n    if (!articles.length) continue;\n    for (let i = 0; i < Math.min(Number(c.clicks_planned), CAP); i++) {\n      const idx = i % articles.length;\n      jobs.push({ json: { campaign: c.name, platform: p, action: 'click',\n        url: `${BASE}/webhook/t/click?c=${encodeURIComponent(c.name)}&l=${idx + 1}&r=automator&u=${encodeURIComponent(articles[idx])}` } });\n    }\n  }\n}\nreturn jobs;"
      }
    },
    {
      "id": "b4",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        720,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "b5",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        960,
        380
      ],
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "webhookId": "enews2-wait"
    },
    {
      "id": "b6",
      "name": "Run in Playwright",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "http://playwright:3000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: $json.platform, action: $json.action, url: $json.url }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "b7",
      "name": "Format Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        380
      ],
      "parameters": {
        "jsCode": "const job = $('Loop Over Items').item.json;\nconst r = $input.item.json;\nreturn [{ json: {\n  date: new Date().toISOString().slice(0, 10),\n  campaign: job.campaign, platform: job.platform, action: job.action,\n  url: job.url, status: r.status ?? 0, success: !!r.success,\n  final_url: r.finalUrl || '', error: r.error || ''\n}}];"
      }
    },
    {
      "id": "b8",
