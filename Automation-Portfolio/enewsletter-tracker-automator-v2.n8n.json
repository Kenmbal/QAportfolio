      "parameters": {
        "jsCode": "const q = $json.query || {};\nconst ua = $json.headers['user-agent'] || '';\nconst ALLOWED = ['yoursite.com'];   // only redirect to your own domains\nlet host = '';\ntry { host = new URL(q.u).hostname; } catch (e) { throw new Error('Bad target URL'); }\nif (!ALLOWED.some(d => host === d || host.endsWith('.' + d))) throw new Error('Blocked redirect target');\nreturn [{ json: {\n  ts: new Date().toISOString(),\n  campaign: q.c, recipient: q.r || '', link_id: q.l || '', action: 'click',\n  device: /iPhone|Android|Mobile/i.test(ua) ? 'mobile' : 'desktop',\n  source: ua.includes('QA-Automator') ? 'automator' : 'real',\n  user_agent: ua, redirect_to: q.u\n}}];"
