      ],
      "parameters": {
        "jsCode": "const BASE = 'https://YOUR-N8N-DOMAIN';   // public URL of your n8n\nconst name = $('Links Page').first().json.query.c;\nconst c = $('Get Campaigns (links)').all().map(i => i.json).find(x => x.name === name);\nif (!c) return [{ json: { html: '<p>Campaign not found</p>' } }];\nconst enc = encodeURIComponent;\nconst articles = String(c.article_urls || '').split('\\n').map(s => s.trim()).filter(Boolean);\n// {{RECIPIENT}} = replace with your sending tool's merge tag (e.g. {{contact.email}})\nlet html = `<html><body style=\"font-family:sans-serif\"><h2>Tracked links for ${name}</h2>` +\n  `<p><b>Open pixel</b> (paste at the bottom of the email):</p><pre>&lt;img src=\"${BASE}/webhook/t/open?c=${enc(name)}&amp;r={{RECIPIENT}}\" width=\"1\" height=\"1\" alt=\"\"&gt;</pre>` +\n  '<p><b>Article links</b>:</p><ol>';\narticles.forEach((u, i) => {\n  html += `<li>${u}<pre>${BASE}/webhook/t/click?c=${enc(name)}&amp;l=${i + 1}&amp;r={{RECIPIENT}}&amp;u=${enc(u)}</pre></li>`;\n});\nreturn [{ json: { html: html + '</ol></body></html>' } }];"
