    {
      "parameters": {
        "jsCode": "// Draft the recall email for each pet.\nconst CLINIC       = 'Happy Paws Vet Clinic (DEMO)';\nconst BOOKING_LINK = 'https://example.com/book';\nconst TEST_MODE    = true;                      // keep true until a real client signs off\nconst TEST_EMAIL   = 'you+vettest@example.com'; // all demo emails go here in test mode\n\nconst copy = {\n  due30:    (p) => ({ subject: `${p.pet_name}'s vaccine is due in 30 days`,\n                      line: `${p.pet_name}'s annual vaccine is due on ${p.nextDue}.` }),\n  due7:     (p) => ({ subject: `Reminder: ${p.pet_name}'s vaccine is due next week`,\n                      line: `Just a reminder that ${p.pet_name}'s vaccine is due on ${p.nextDue}.` }),\n  dueToday: (p) => ({ subject: `${p.pet_name}'s vaccine is due today`,\n                      line: `${p.pet_name}'s vaccine is due today.` }),\n  overdue7: (p) => ({ subject: `${p.pet_name}'s vaccine is now overdue`,\n                      line: `${p.pet_name}'s vaccine was due on ${p.nextDue}. Let's get it done soon.` }),\n};\n\nreturn $input.all().map(({ json: r }) => {\n  const c = copy[r.bucket](r);\n  return { json: {\n    to: TEST_MODE ? TEST_EMAIL : r.email,\n    subject: c.subject,\n    body: `Hi ${r.owner_first_name},\\n\\n${c.line}\\n\\nBook a visit here: ${BOOKING_LINK}\\n\\n- ${CLINIC}`,\n    pet: r.pet_name,\n    bucket: r.bucket\n  }};\n});"
      },
