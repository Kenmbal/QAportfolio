    {
      "parameters": {
        "jsCode": "// Build the GHL contact-upsert body. Tags drive the GHL recall workflows.\nconst LOCATION_ID = 'YOUR_GHL_LOCATION_ID';\nconst tagByBucket = {\n  overdue: 'vaccine-overdue',\n  due7:    'vaccine-due-7d',\n  due30:   'vaccine-due-30d',\n};\n\nreturn $input.all().map(({ json: r }) => ({\n  json: {\n    locationId: LOCATION_ID,\n    firstName: r.owner_first_name,\n    lastName:  r.owner_last_name,\n    email: r.email,\n    phone: r.phone,\n    tags: ['vet-recall', tagByBucket[r.bucket]],\n    customFields: [\n      { key: 'pet_name',         field_value: r.pet_name },\n      { key: 'pet_species',      field_value: r.species },\n      { key: 'next_vaccine_due', field_value: r.nextDue }\n    ]\n  }\n}));"
      },
