      "id": "ee54a1f3-441d-4adf-a1bb-3d4264cb3c23",
      "name": "Read Clinic Export",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        300,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize + validate each pet row from the clinic export (FAKE demo data only)\nconst COUNTRY_CODE = '+63';          // change per client (+1 for US)\nconst VACCINE_INTERVAL_DAYS = 365;   // annual booster in this demo\nconst today = new Date(); today.setHours(0, 0, 0, 0);\n\nreturn $input.all().map(({ json: r }) => {\n  const digits = String(r.owner_phone || '').replace(/\\D/g, '');\n  const phone  = digits.length >= 10 ? COUNTRY_CODE + digits.slice(-10) : '';\n  const email  = String(r.owner_email || '').trim().toLowerCase();\n  const last   = new Date(r.last_vaccine_date);\n  const validDate = !isNaN(last);\n\n  let nextDue = '', daysUntilDue = null, bucket = 'invalid';\n  if (validDate) {\n    const d = new Date(last);\n    d.setDate(d.getDate() + VACCINE_INTERVAL_DAYS);\n    nextDue = d.toISOString().slice(0, 10);\n    daysUntilDue = Math.round((d - today) / 86400000);\n    bucket = daysUntilDue < 0 ? 'overdue'\n           : daysUntilDue <= 7 ? 'due7'\n           : daysUntilDue <= 30 ? 'due30' : 'ok';\n  }\n  const hasContact = Boolean(phone) || /.+@.+\\..+/.test(email);\n  const valid = validDate && hasContact;\n\n  return { json: { ...r, phone, email, nextDue, daysUntilDue, bucket, valid,\n                   reason: valid ? '' : 'bad date or no usable phone/email' } };\n});"
      },
      "id": "5b90a3ee-9f7e-4e86-8042-c5a2455188df",
      "name": "Normalize & Validate",
