    {
      "parameters": {
        "jsCode": "// Normalize + validate each pet row from the clinic export (FAKE demo data only)\nconst VACCINE_INTERVAL_DAYS = 365;   // annual booster in this demo\nconst today = new Date(); today.setHours(0, 0, 0, 0);\n\nreturn $input.all().map(({ json: r }) => {\n  const email = String(r.owner_email || '').trim().toLowerCase();\n  const last  = new Date(r.last_vaccine_date);\n  const validDate  = !isNaN(last);\n  const validEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n  let nextDue = '', daysUntilDue = null, bucket = 'invalid';\n  if (validDate) {\n    const d = new Date(last);\n    d.setDate(d.getDate() + VACCINE_INTERVAL_DAYS);\n    nextDue = d.toISOString().slice(0, 10);\n    daysUntilDue = Math.round((d - today) / 86400000);\n\n    // Stateless dedupe: only act on exact milestone days, so the daily run\n    // never sends the same reminder twice. (Workflow must run every day.)\n    bucket = daysUntilDue === 30 ? 'due30'\n           : daysUntilDue === 7  ? 'due7'\n           : daysUntilDue === 0  ? 'dueToday'\n           : daysUntilDue === -7 ? 'overdue7'\n           : 'skip';\n  }\n  const valid = validDate && validEmail;\n  return { json: { ...r, email, nextDue, daysUntilDue, bucket, valid,\n                   reason: valid ? '' : 'bad vaccine date or invalid email' } };\n});"
      },
