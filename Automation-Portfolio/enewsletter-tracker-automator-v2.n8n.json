      "parameters": {
        "jsCode": "const campaigns = $('Get Campaigns').all().map(i => i.json).filter(c => c.name);\nconst events = $('Get Events').all().map(i => i.json).filter(e => e.campaign);\nconst today = new Date().toISOString().slice(0, 10);\nconst count = (c, d, a, src) => events.filter(e =>\n  e.campaign === c && e.device === d && e.action === a && e.source === src &&\n  String(e.ts).slice(0, 10) === today).length;\n\nlet html = '<html><body style=\"font-family:sans-serif\"><h2>Open &amp; Click Report - ' + today + '</h2>' +\n  '<h3>Robot test: planned vs recorded</h3><table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">' +\n  '<tr><th>Campaign</th><th>Device</th><th>Action</th><th>Planned</th><th>Recorded</th><th>Result</th></tr>';\nfor (const c of campaigns) {\n  const devices = c.platform === 'both' ? ['desktop', 'mobile'] : [c.platform];\n  for (const d of devices) for (const a of ['open', 'click']) {\n    const planned = Number(a === 'open' ? c.opens_planned : c.clicks_planned);\n    const got = count(c.name, d, a, 'automator');\n    const ok = got >= planned;\n    html += `<tr><td>${c.name}</td><td>${d}</td><td>${a}</td><td>${planned}</td><td>${got}</td>` +\n      `<td style=\"color:${ok ? 'green' : 'red'}\">${ok ? 'SUCCESS' : 'FAIL (' + (planned - got) + ' missing)'}</td></tr>`;\n  }\n}\nhtml += '</table><h3>Real subscriber activity today</h3><table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">' +\n  '<tr><th>Campaign</th><th>Device</th><th>Opens</th><th>Clicks</th></tr>';\nconst camps = [...new Set(events.map(e => e.campaign))];\nfor (const c of camps) for (const d of ['desktop', 'mobile'])\n  html += `<tr><td>${c}</td><td>${d}</td><td>${count(c, d, 'open', 'real')}</td><td>${count(c, d, 'click', 'real')}</td></tr>`;\nhtml += '</table></body></html>';\nreturn [{ json: { html } }];"
