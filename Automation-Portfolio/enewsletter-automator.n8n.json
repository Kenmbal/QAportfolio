{
  "name": "eNewsletter Open/Click Automator",
  "nodes": [
    {
      "id": "a1",
      "name": "Create Campaign Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Create Open/Click Campaign",
        "formDescription": "Plan how many opens and clicks to run each day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "platform",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "desktop"
                  },
                  {
                    "option": "mobile"
                  },
                  {
                    "option": "both"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "opens_planned",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "clicks_planned",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "active",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "true"
                  },
                  {
                    "option": "false"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      },
      "webhookId": "enews-campaign-form"
    },
    {
      "id": "a2",
      "name": "Pick Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const j = $input.first().json;\nreturn [{ json: {\n  name: j.name,\n  platform: j.platform,\n  opens_planned: Number(j.opens_planned),\n  clicks_planned: Number(j.clicks_planned),\n  active: String(j.active)\n}}];"
      }
    },
    {
      "id": "a3",
      "name": "Save Campaign",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      }
    },
    {
      "id": "b1",
      "name": "Every Day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "b2",
      "name": "Get Latest Newsletter",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 1,
        "simple": false,
        "filters": {
          "q": "from:YOUR_NEWSLETTER_SENDER"
        }
      }
    },
    {
      "id": "b3",
      "name": "Parse Newsletter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "const first = $input.first().json;\nconst html = first.html || first.textHtml || '';\nconst pixels = [...html.matchAll(/<img[^>]+src=[\"']([^\"']+)[\"']/gi)]\n  .map(m => m[1])\n  .filter(u => /open|track|pixel|\\.gif/i.test(u));\nconst links = [...new Set(\n  [...html.matchAll(/<a[^>]+href=[\"'](https?:[^\"']+)[\"']/gi)].map(m => m[1])\n)];\nreturn [{ json: { pixel: pixels[0] || null, links } }];"
      }
    },
    {
      "id": "b4",
      "name": "Get Campaigns",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "returnAll": true
      }
    },
    {
      "id": "b5",
      "name": "Build Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "jsCode": "const { pixel, links } = $('Parse Newsletter').first().json;\nconst CAP = 200; // safety cap per campaign per action\nconst jobs = [];\nfor (const c of $('Get Campaigns').all().map(i => i.json)) {\n  if (String(c.active) !== 'true') continue;\n  const platforms = c.platform === 'both' ? ['desktop', 'mobile'] : [c.platform];\n  for (const p of platforms) {\n    if (pixel) {\n      for (let i = 0; i < Math.min(Number(c.opens_planned), CAP); i++)\n        jobs.push({ json: { campaign: c.name, platform: p, action: 'open', url: pixel } });\n    }\n    for (let i = 0; i < Math.min(Number(c.clicks_planned), CAP); i++)\n      jobs.push({ json: { campaign: c.name, platform: p, action: 'click', url: links[i % links.length] } });\n  }\n}\nreturn jobs;"
      }
    },
    {
      "id": "b6",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "b7",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1440,
        380
      ],
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "webhookId": "enews-wait"
    },
    {
      "id": "b8",
      "name": "Run in Playwright",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        380
      ],
      "parameters": {
        "method": "POST",
        "url": "http://playwright:3000/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platform: $json.platform, action: $json.action, url: $json.url }) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "b9",
      "name": "Format Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        380
      ],
      "parameters": {
        "jsCode": "const job = $('Loop Over Items').item.json;\nconst r = $input.item.json;\nreturn [{ json: {\n  date: new Date().toISOString().slice(0, 10),\n  campaign: job.campaign,\n  platform: job.platform,\n  action: job.action,\n  url: job.url,\n  status: r.status ?? 0,\n  success: !!r.success,\n  final_url: r.finalUrl || '',\n  error: r.error || ''\n}}];"
      }
    },
    {
      "id": "b10",
      "name": "Save Result",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        2160,
        380
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        }
      }
    },
    {
      "id": "b11",
      "name": "Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "jsCode": "const rows = $('Format Result').all().map(i => i.json);\nconst sum = {};\nfor (const r of rows) {\n  const k = `${r.campaign}|${r.platform}|${r.action}`;\n  sum[k] ??= { ok: 0, fail: 0 };\n  r.success ? sum[k].ok++ : sum[k].fail++;\n}\nlet html = '<h3>Daily open/click report</h3><table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Campaign</th><th>Platform</th><th>Action</th><th>Success</th><th>Fail</th></tr>';\nfor (const [k, v] of Object.entries(sum)) {\n  const [c, p, a] = k.split('|');\n  html += `<tr><td>${c}</td><td>${p}</td><td>${a}</td><td>${v.ok}</td><td>${v.fail}</td></tr>`;\n}\nhtml += '</table>';\nreturn [{ json: { html } }];"
      }
    },
    {
      "id": "b12",
      "name": "Email Summary",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1680,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "YOU@example.com",
        "subject": "Daily newsletter open/click report",
        "emailType": "html",
        "message": "={{ $json.html }}"
      }
    },
    {
      "id": "c1",
      "name": "Report Page",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        640
      ],
      "parameters": {
        "path": "enews-report",
        "httpMethod": "GET",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "enews-report"
    },
    {
      "id": "c2",
      "name": "Get Results",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        240,
        640
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "returnAll": true
      }
    },
    {
      "id": "c3",
      "name": "Build HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        640
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst sum = {};\nfor (const r of rows) {\n  const k = `${r.date}|${r.campaign}|${r.platform}|${r.action}`;\n  sum[k] ??= { ok: 0, fail: 0 };\n  (r.success === true || r.success === 'true') ? sum[k].ok++ : sum[k].fail++;\n}\nlet html = '<html><body style=\"font-family:sans-serif\"><h2>Open &amp; Click Report</h2><table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Date</th><th>Campaign</th><th>Platform</th><th>Action</th><th>Success</th><th>Fail</th></tr>';\nfor (const [k, v] of Object.entries(sum).sort().reverse()) {\n  const [d, c, p, a] = k.split('|');\n  html += `<tr><td>${d}</td><td>${c}</td><td>${p}</td><td>${a}</td><td style=\"color:green\">${v.ok}</td><td style=\"color:red\">${v.fail}</td></tr>`;\n}\nhtml += '</table></body></html>';\nreturn [{ json: { html } }];"
      }
    },
    {
      "id": "c4",
      "name": "Send Page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        640
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
      }
    }
  ],
